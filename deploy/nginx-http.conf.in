# Certbot's HTTP-01 challenge is served independently of the Go service.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};
    server_tokens off;
    client_max_body_size 1k;
    client_header_timeout 10s;
    client_body_timeout 10s;

    location ^~ /.well-known/acme-challenge/ {
        root ${ACME_DIR};
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}
